{
  "name": "Python en Docker Compose",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "app",
  "workspaceFolder": "/code",
  "remoteUser": "appuser",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "eamodio.gitlens",
        "esbenp.prettier-vscode",
        "ms-python.black-formatter",
        "ms-python.debugpy",
        "cweijan.vscode-database-client2",
        "shibiao.ai-commit-lite"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "python.formatting.provider": "none"
      }
    }
  },
  "mounts": [],
  "postCreateCommand": "sudo chown -R appuser:appuser /code/.git"
}
