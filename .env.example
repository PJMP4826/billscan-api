# Google Gemini API 
GOOGLE_API_KEY=your_google_api_key_here
LLM_GEMINI_MODEL=gemini-3.1-flash-lite

#sever
HOST_SERVER=0.0.0.0
PORT_SERVER=8000

# PostgreSQL Database 
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_PORT=5432
DB_HOST=host.internal.docker

# Cloudflare R2 (S3-compatible) File Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
# Optional — if set, upload() returns a public URL instead of a presigned one
# R2_PUBLIC_BASE_URL=https://cdn.yourdomain.com

# Docker Compose
COMPOSE_PROJECT_NAME=billscan-api
# Corre migraciones al iniciar el contenedor (false en réplicas/deploy de producción)
RUN_MIGRATIONS=true

# Billing Providers

# FacturaGPT Provider Credentials
FACTURAGPT_BASE_URL=https://api.facturagpt.com.mx
FACTURAGPT_API_KEY=your_facturagpt_api_key
FACTURAGPT_TEST_MODE=true
FACTURAGPT_WEBHOOK_SECRET=whsec_....

# Cuota de facturas por RFC (compartida entre cuentas con el mismo RFC)
BILLING_MAX_INVOICES_PER_RFC=3
# Secreto opcional para el fingerprint HMAC-SHA256 del RFC.
# Si se deja vacío se usa ENCRYPTION_KEY.
RFC_HASH_SECRET=

# Security Configuration
# Data Encryptors
ENCRYPTION_KEY=your_encryption_key

# Clerk Auth
CLERK_SECRET_KEY=sk_test_....
# Opcional: orígenes (azp) permitidos para los tokens, separados por coma.
# CLERK_AUTHORIZED_PARTIES=https://app.billscan.mx,http://localhost:3000
# Opcional: audience si usas JWT templates.
# CLERK_AUDIENCE=

# DEBUG 
DEBUG_MODE=false
LOG_TO_FILE=false
